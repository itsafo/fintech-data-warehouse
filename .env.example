# Copy to .env and fill in. Never commit the real .env file.
#
# Local dev bootstrap values only -- the running pipeline reads DB creds via
# the Airflow Connection `local_warehouse` (orchestration/airflow_settings.yaml),
# not from this file. This file's POSTGRES_* values are consumed by:
#   - Terraform, if you export them as TF_VAR_postgres_password etc.
#   - dbt's profiles.yml (dbt/profiles.yml uses env_var() with these names)
#   - the sql/control_schema.sql psql bootstrap when run manually

# --- Postgres (local_warehouse container) ---
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Terraform reads these as TF_VAR_<name> -- export before `terraform apply`,
# don't rely on the insecure defaults baked into terraform/variables.tf
# beyond throwaway local dev.
TF_VAR_postgres_password=dev_password
TF_VAR_pipeline_writer_password=pipeline_writer_password
TF_VAR_analyst_reader_password=analyst_reader_password

# --- Docker (macOS + Docker Desktop) ---
# Terraform's Docker provider defaults to /var/run/docker.sock, which Docker Desktop
# does not create. Export this in your shell before terraform plan/apply:
#   export DOCKER_HOST=unix://$HOME/.docker/run/docker.sock

# --- MinIO (bronze-raw object storage) ---
# minio_admin/root creds are only ever used by Terraform itself to bootstrap
# the bucket + scoped pipeline_writer service account -- the pipeline never
# authenticates as root. After `terraform apply`, read the generated service
# account keys with `terraform output minio_pipeline_writer_access_key` and
# `terraform output -raw minio_pipeline_writer_secret_key`, then paste them
# into the minio_bronze connection in orchestration/airflow_settings.yaml.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_password
TF_VAR_minio_root_password=minio_admin_password

# --- dbt target ---
DBT_TARGET=dev

# --- Email alerts (Airflow SMTP backend) ---
# Astro CLI loads .env into the Airflow containers' environment, so these
# AIRFLOW__SMTP__* vars configure Airflow's built-in send_email() directly.
# With Gmail: create an "app password" (not your account password) at
# https://myaccount.google.com/apppasswords -- 2FA must be enabled first.
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_MAIL_FROM=you@example.com
AIRFLOW__SMTP__SMTP_USER=you@example.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-16-char-app-password

# Comma-separated list of recipients for failure + run-summary emails
# (read by orchestration/dags/utils/notifications.py).
ALERT_EMAIL_TO=you@example.com

# --- GitHub Actions CI ---
# Set these as repository secrets (Settings -> Secrets and variables ->
# Actions), never as plain workflow env vars. See README "CI/CD secrets".
#   TF_POSTGRES_PASSWORD
#   TF_PIPELINE_WRITER_PASSWORD
#   TF_ANALYST_READER_PASSWORD
#   TF_MINIO_ROOT_PASSWORD

# =====================================================================
# --- Production deploy (orchestration/docker-compose.prod.yaml) ---
# Everything below this line is irrelevant to `astro dev start` -- it's
# only consumed by the standalone prod Airflow stack, which .env.example
# documents for reference, but which .github/workflows/deploy_prod.yml
# actually WRITES on the VM from GitHub repository secrets (never from
# this file). See README "Production deployment" for the full secrets
# list and one-time VM/Terraform Cloud setup this depends on.
# =====================================================================

# Airflow's Fernet key (encrypts Connections/Variables at rest) and
# webserver session secret -- generate each once, keep stable across
# deploys, never regenerate casually (a Fernet key change makes
# previously-encrypted values undecryptable).
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=

# Dedicated metadata DB for the prod Airflow stack -- separate from
# local_warehouse (the actual data warehouse).
AIRFLOW_METADATA_DB_PASSWORD=

# Prod admin login, created once by the airflow-init service.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=you@example.com

# Connections, in URI form, since prod has no airflow_settings.yaml to
# auto-load them from. Hostnames are the "prod" Terraform workspace's
# container names (local_warehouse_prod, minio_prod) -- both containers
# on data_platform_net, not published to the host. MinIO access/secret
# key come from `terraform output minio_pipeline_writer_access_key` /
# `terraform output -raw minio_pipeline_writer_secret_key` after the
# FIRST prod terraform apply (chicken-and-egg: that first apply has to be
# run manually before these two values exist to put in CI secrets).
AIRFLOW_CONN_LOCAL_WAREHOUSE=postgres://dev_user:REPLACE_WITH_PROD_POSTGRES_PASSWORD@local_warehouse_prod:5432/warehouse
AIRFLOW_CONN_MINIO_BRONZE=generic://REPLACE_WITH_ACCESS_KEY:REPLACE_WITH_SECRET_KEY@minio_prod:9000?bucket=bronze-raw
